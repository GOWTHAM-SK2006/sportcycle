# SportCycle Frontend Environment Configuration Template

# Backend REST API Base URL
NEXT_PUBLIC_API_URL=https://sportcycle-backend.up.railway.app/api/v1

# Supabase Public Keys (Only public anon key exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://<your-supabase-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Razorpay Client Public Key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_sampleKey123

