# SportCycle Backend Environment Configuration Template

# Server & Profile
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Supabase PostgreSQL Database (Use Session Pooler for Railway IPv4 compatibility)
DATABASE_URL=jdbc:postgresql://aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.<your-project-ref>
DATABASE_PASSWORD=<your-supabase-db-password>

# JWT Authentication
JWT_SECRET=sportcycle_ultra_secure_jwt_secret_key_minimum_256_bits_for_production_2026!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Supabase Storage (for product images)
SUPABASE_URL=https://<your-supabase-project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-secret-key>
SUPABASE_STORAGE_BUCKET=sportcycle-products

# Razorpay Payment Gateway (Test/Live Credentials)
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sampleSecret123456789
RAZORPAY_WEBHOOK_SECRET=sampleWebhookSecret123

# CORS (Frontend URL in production)
CORS_ALLOWED_ORIGINS=https://sportcycle-frontend.up.railway.app,http://localhost:3000
